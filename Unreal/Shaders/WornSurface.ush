// 硬表面通用材质（Godot 版 assets/shaders/worn_surface.gdshaderinc 的移植，算法、参数名、默认值都不变）：
// 底漆颜色 + 物体空间三平面映射的细节贴图 + 曲率顶点色（R = 棱边磨损，G = 凹槽积垢）。
// 另外叠加：锈、掉漆分层（漆 → 红丹底漆 → 钢）、指纹油污、积灰、流痕、大尺度脏污、地板脏、冷凝水珠、焊接变形起伏、漆层台阶。
// 不依赖 UV。破舱那一段（BREACH）以后搬破舱时再加。
//
// 下面的参数表由 Scripts/build_materials.py 读取，建成同名的材质参数（颜色给的是 Godot 里的 sRGB 值，脚本转成线性）：
// @tex grime_albedo color white
// @tex grime_normal normal flat
// @tex grime_arm linear white
// @tex smudge_tex linear black
// @tex streak_tex linear black
// @tex rust_albedo color white
// @tex chip_tex linear black
// @color paint_color 0.42 0.06 0.035
// @float paint_roughness 0.55
// @float paint_metallic 0.1
// @float paint_variation 0.35
// @bool arm_packed 1
// @float tex_scale 1.0
// @float normal_strength 0.6
// @float rough_variation 0.0
// @float rust_amount 0.25
// @float cavity_dirt 1.0
// @float edge_wear 0.8
// @color wear_color 0.42 0.4 0.37
// @float smudge_amount 0.0
// @float smudge_scale 4.0
// @float dust_amount 0.0
// @color dust_color 0.46 0.44 0.4
// @float streak_amount 0.0
// @float streak_scale 1.0
// @color streak_color 0.3 0.22 0.14
// @float streak_cover 1.0
// @float streak_replace 0.0
// @bool streak_down 0
// @float streak_top 3.0
// @float macro_amount 0.0
// @float macro_scale 0.18
// @float floor_dirt 0.0
// @float floor_height -0.9
// @float floor_fade 0.65
// @color floor_color 0.2 0.18 0.15
// @float condensation 0.0
// @float droplet_scale 125.0
// @float cond_height 0.2
// @float cond_patch_scale 0.55
// @float cond_patch_cover 0.35
// @float cond_cavity 1.0
// @float wear_metallic 0.85
// @float bare_roughness 0.35
// @bool use_rust_albedo 0
// @bool albedo_direct 0
// @float top_dirt 0.0
// @float top_fade 0.6
// @color top_color 0.66 0.56 0.38
// @float corner_dirt 0.0
// @float corner_width 0.22
// @vec room_min -1000 -1000 -1000
// @vec room_max 1000 1000 1000
// @float primer_amount 0.0
// @color primer_color 0.32 0.11 0.065
// @float chip_amount 0.0
// @float chip_scale 2.0
// @float chip_cover 0.5
// @float bare_rust 0.0
// @float paint_depth 0.0
// @float warp_amount 0.0
// @float warp_scale 2.5
// @color emission_color 0 0 0
// @float emission_energy 0.0
#pragma once

#include "/Guixu/GuixuCommon.ush"

struct FGXWornParams
{
	float3 paint_color; float paint_roughness; float paint_metallic; float paint_variation;
	float arm_packed; float tex_scale; float normal_strength; float rough_variation;
	float rust_amount; float cavity_dirt; float edge_wear; float3 wear_color;
	float smudge_amount; float smudge_scale;
	float dust_amount; float3 dust_color;
	float streak_amount; float streak_scale; float3 streak_color; float streak_cover; float streak_replace; float streak_down; float streak_top;
	float macro_amount; float macro_scale;
	float floor_dirt; float floor_height; float floor_fade; float3 floor_color;
	float condensation; float droplet_scale; float cond_height; float cond_patch_scale; float cond_patch_cover; float cond_cavity;
	float wear_metallic; float bare_roughness; float use_rust_albedo; float albedo_direct;
	float top_dirt; float top_fade; float3 top_color; float corner_dirt; float corner_width; float3 room_min; float3 room_max;
	float primer_amount; float3 primer_color; float chip_amount; float chip_scale; float chip_cover; float bare_rust;
	float paint_depth; float warp_amount; float warp_scale;
	float3 emission_color; float emission_energy;
};

// 一层水珠：返回 (表面斜率 xy, 覆盖 z)。竖直面上的水珠往下坠（下半截更圆更大）
float3 GX_DropletLayer(float2 uv, float density)
{
	float2 cell = floor(uv);
	float2 f = frac(uv);
	float3 best = 0.0;
	for (int j = -1; j <= 1; j++)
	{
		for (int i = -1; i <= 1; i++)
		{
			float2 g = float2(i, j);
			float2 h = GX_Hash22(cell + g);
			if (frac(h.x * 7.13 + h.y * 3.71) > density)
			{
				continue;
			}
			float2 q = f - (g + 0.2 + h * 0.6);
			float rad = lerp(0.14, 0.4, frac(h.y * 13.7 + h.x));
			q.y *= q.y < 0.0 ? 0.8 : 1.3;
			float d = length(q) / rad;
			float m = 1.0 - smoothstep(0.8, 1.0, d);
			if (m > best.z)
			{
				best = float3(q / rad * 0.9, m);
			}
		}
	}
	return best;
}

float3 GX_Droplets2(float2 uv, float density)
{
	float3 a = GX_DropletLayer(uv, density);
	float3 b = GX_DropletLayer(uv * 2.3 + 17.1, min(density * 1.2, 1.0));
	return a.z >= b.z ? a : b;
}

// LocalPosCm / LocalNormal：UE 局部坐标（厘米）；Wear：顶点色
FGXSurface GX_WornSurface(FGXWornParams P, float3 LocalPosCm, float3 LocalNormal, float3 Wear,
	Texture2D grime_albedo, SamplerState grime_albedoSampler,
	Texture2D grime_normal, SamplerState grime_normalSampler,
	Texture2D grime_arm, SamplerState grime_armSampler,
	Texture2D smudge_tex, SamplerState smudge_texSampler,
	Texture2D streak_tex, SamplerState streak_texSampler,
	Texture2D rust_albedo, SamplerState rust_albedoSampler,
	Texture2D chip_tex, SamplerState chip_texSampler)
{
	FGXSurface S = GX_DefaultSurface();
	const float3 obj_pos = GX_PosToGodot(LocalPosCm);
	const float3 n = normalize(GX_DirToGodot(LocalNormal));
	const float3 w = GX_TriWeights(n, 4.0);
	const float3 p = obj_pos * P.tex_scale;
	float4 g = GX_Tri(grime_albedo, grime_albedoSampler, p, w);
	float4 arm = GX_Tri(grime_arm, grime_armSampler, p, w);
	if (P.arm_packed < 0.5)
	{
		arm = float4(1.0, arm.r, 0.0, 1.0);
	}
	float lum = dot(g.rgb, float3(0.299, 0.587, 0.114));

	float edge = Wear.r;
	float cav = Wear.g;
	float noise = GX_Tri(grime_albedo, grime_albedoSampler, p * 0.37 + 0.13, w).g;

	float3 col = P.albedo_direct > 0.5 ? g.rgb * P.paint_color : P.paint_color * lerp(1.0, 0.6 + lum * 1.4, P.paint_variation);
	float3 rust_col = P.use_rust_albedo > 0.5 ? GX_Tri(rust_albedo, rust_albedoSampler, p, w).rgb : g.rgb;
	float rough = clamp(P.paint_roughness + (arm.g - 0.5) * P.rough_variation, 0.04, 1.0);
	float metal = P.paint_metallic;

	if (P.macro_amount > 0.0)
	{
		float3 mp = obj_pos * P.macro_scale;
		float m = GX_Tri(grime_albedo, grime_albedoSampler, mp + 0.31, w).r * 0.6 + GX_Tri(grime_albedo, grime_albedoSampler, mp * 0.37 + 0.71, w).g * 0.4;
		m = (m - 0.5) * 2.0;
		col *= 1.0 + m * P.macro_amount * 0.35;
		rough = clamp(rough + m * P.macro_amount * 0.18, 0.05, 1.0);
	}

	// 锈蚀：凹槽里先长，再按噪声扩散
	float rust = smoothstep(0.55, 0.8, P.rust_amount + cav * P.cavity_dirt * 0.6 + (noise - 0.5) * 0.8);
	col = lerp(col, rust_col, rust);
	rough = lerp(rough, arm.g, rust);
	metal = lerp(metal, arm.b, rust);

	// 棱边磨出底下的金属（阈值偏高：只有真正的棱边才掉漆）
	float er = edge * P.edge_wear + (noise - 0.5) * 0.5;
	float e = smoothstep(0.55, 0.9, er);
	float height = 1.0;  // 漆面 1，底漆 0.5，钢 0（给 paint_depth 算掉漆边上的台阶）
	float3 bare = P.wear_color;
	float old = 0.0;
	if (P.primer_amount > 0.0 || P.chip_amount > 0.0)
	{
		float chip = 0.0;
		if (P.chip_amount > 0.0)
		{
			float3 cp = obj_pos * P.chip_scale;
			float c = Texture2DSample(chip_tex, chip_texSampler, cp.zy).r * w.x + Texture2DSample(chip_tex, chip_texSampler, cp.xz).r * w.y
					+ Texture2DSample(chip_tex, chip_texSampler, cp.xy).r * w.z;
			float zn = GX_ValueNoise(obj_pos * 2.3 + 5.1) * 0.7 + GX_ValueNoise(obj_pos * 6.1 + 1.7) * 0.3;
			float region = smoothstep(1.0 - P.chip_cover - 0.1, 1.0 - P.chip_cover + 0.15, zn);
			float low = 1.0 - smoothstep(P.floor_height, P.floor_height + 0.45, obj_pos.y);
			chip = smoothstep(0.08, 0.6, c) * P.chip_amount * clamp(region + low * 0.9, 0.0, 1.0);
		}
		// 棱边掉漆一段一段的
		float brk = GX_ValueNoise(obj_pos * 7.0 + 2.9) * 0.65 + GX_ValueNoise(obj_pos * 19.0 + 0.7) * 0.35;
		float3 ep = obj_pos * P.chip_scale * 2.0;
		float etex = Texture2DSample(chip_tex, chip_texSampler, ep.zy).r * w.x + Texture2DSample(chip_tex, chip_texSampler, ep.xz).r * w.y
				+ Texture2DSample(chip_tex, chip_texSampler, ep.xy).r * w.z;
		float edge_r = smoothstep(0.5, 0.9, er) * smoothstep(0.35, 0.65, brk + etex * 0.6);
		float r = max(edge_r, chip);
		float t0 = 0.45 - P.primer_amount * 0.3;
		float aa = max(fwidth(r) * 1.5, 0.03);   // 掉漆边缘按像素宽度抗锯齿，远处不闪
		float pm = smoothstep(t0 - aa, t0 + aa, r) * (1.0 - rust);
		e = smoothstep(0.62 - aa, 0.62 + aa, r);
		col = lerp(col, P.primer_color * (0.8 + noise * 0.4), pm);
		rough = lerp(rough, 0.72, pm);
		metal = lerp(metal, 0.0, pm);
		height = 1.0 - pm * 0.5 - e * 0.5;
		// 磕出来的钢（不是手磨亮的棱边）发锈发暗
		old = P.bare_rust * clamp(chip - edge_r * 0.6, 0.0, 1.0) * (0.6 + noise * 0.8);
		old = clamp(old, 0.0, 1.0);
		bare = lerp(P.wear_color, rust_col * 0.7, old);
	}
	col = lerp(col, bare, e * (1.0 - rust));
	metal = lerp(metal, P.wear_metallic, e * (1.0 - rust));
	rough = lerp(rough, lerp(P.bare_roughness, 0.75, old), e * (1.0 - rust));
	metal = lerp(metal, 0.45, e * old * (1.0 - rust));

	// 凹槽积垢
	col *= 1.0 - cav * P.cavity_dirt * 0.35;

	if (P.floor_dirt > 0.0)
	{
		float f = 1.0 - smoothstep(P.floor_height, P.floor_height + P.floor_fade, obj_pos.y);
		f = clamp(f * (0.55 + noise * 0.9), 0.0, 1.0) * P.floor_dirt;
		col = lerp(col, col * P.floor_color * 2.2, f);
		rough = lerp(rough, 0.8, f * 0.6);
		metal = lerp(metal, 0.0, f * 0.5);
	}

	if (P.top_dirt > 0.0)
	{
		float t = smoothstep(P.streak_top - P.top_fade, P.streak_top, obj_pos.y) * P.top_dirt * (0.7 + noise * 0.6);
		col = lerp(col, col * P.top_color * 1.6, clamp(t, 0.0, 1.0));
	}
	if (P.corner_dirt > 0.0)
	{
		float3 da = abs(obj_pos - P.room_min);
		float3 db = abs(P.room_max - obj_pos);
		// 六个面的距离里第二近的那个（第一近的是自己所在的那面）
		float ds[6] = { da.x, da.y, da.z, db.x, db.y, db.z };
		float d1 = 1e5;
		float d2 = 1e5;
		for (int i = 0; i < 6; i++)
		{
			float x = ds[i];
			if (x < d1) { d2 = d1; d1 = x; }
			else if (x < d2) { d2 = x; }
		}
		float k = (1.0 - smoothstep(0.0, P.corner_width, d2)) * P.corner_dirt * (0.6 + noise * 0.8);
		col *= 1.0 - 0.3 * clamp(k, 0.0, 1.0);
		rough = clamp(rough + 0.05 * k, 0.0, 1.0);
	}

	// 指纹/油污：更光滑 + 略暗
	if (P.smudge_amount > 0.0)
	{
		float3 sp = obj_pos * P.smudge_scale;
		float s = (Texture2DSample(smudge_tex, smudge_texSampler, sp.zy).r * w.x + Texture2DSample(smudge_tex, smudge_texSampler, sp.xz).r * w.y
				+ Texture2DSample(smudge_tex, smudge_texSampler, sp.xy).r * w.z) * P.smudge_amount;
		rough = lerp(rough, rough * 0.55 + 0.08, s);
		col *= 1.0 - s * 0.12;
	}

	// 水渍流痕：只在竖直面出现，颜色发褐，表面发亮（湿）
	if (P.streak_amount > 0.0)
	{
		float3 sp = obj_pos * P.streak_scale;
		float side = 1.0 - w.y;
		float st;
		if (P.streak_down > 0.5)
		{
			float v = clamp((P.streak_top - obj_pos.y) * P.streak_scale, 0.0, 0.999);
			st = (Texture2DSample(streak_tex, streak_texSampler, float2(sp.z, v)).r * w.x + Texture2DSample(streak_tex, streak_texSampler, float2(sp.x, v)).r * w.z) / max(w.x + w.z, 1e-4);
		}
		else
		{
			st = (Texture2DSample(streak_tex, streak_texSampler, sp.zy).r * w.x + Texture2DSample(streak_tex, streak_texSampler, sp.xy).r * w.z) / max(w.x + w.z, 1e-4);
		}
		st = smoothstep(0.2, 0.9, st) * P.streak_amount * side;
		if (P.streak_cover < 1.0)
		{
			float3 zp = obj_pos * float3(1.6, 0.35, 1.6);
			float zn = GX_ValueNoise(zp + 3.1) * 0.75 + GX_ValueNoise(zp * 3.1 + 8.7) * 0.25;
			st *= smoothstep(1.0 - P.streak_cover - 0.1, 1.0 - P.streak_cover + 0.15, zn);
		}
		col = lerp(col, lerp(col * P.streak_color * 1.6, P.streak_color, P.streak_replace), st);
		rough = lerp(rough, 0.25, st * 0.7);
	}

	// 积灰：只落在朝上的面，凹槽里多一点
	if (P.dust_amount > 0.0)
	{
		float up = smoothstep(0.35, 0.9, n.y);
		float d = clamp(up * P.dust_amount * (0.6 + noise * 0.8) + cav * P.dust_amount * 0.4, 0.0, 1.0);
		col = lerp(col, P.dust_color, d * 0.75);
		rough = lerp(rough, 0.95, d);
		metal = lerp(metal, 0.0, d);
	}

	float3 nn = GX_TriNormal(grime_normal, grime_normalSampler, p, n, w, P.normal_strength);

	if (P.warp_amount > 0.0)
	{
		// 两层值噪声当高度场，取切向梯度把法线拧歪一点
		float3 wp = obj_pos * P.warp_scale;
		const float H = 0.04;
		float h0 = GX_ValueNoise(wp) + GX_ValueNoise(wp * 2.7 + 3.3) * 0.35;
		float3 gr = float3(GX_ValueNoise(wp + float3(H, 0, 0)) + GX_ValueNoise((wp + float3(H, 0, 0)) * 2.7 + 3.3) * 0.35,
				GX_ValueNoise(wp + float3(0, H, 0)) + GX_ValueNoise((wp + float3(0, H, 0)) * 2.7 + 3.3) * 0.35,
				GX_ValueNoise(wp + float3(0, 0, H)) + GX_ValueNoise((wp + float3(0, 0, H)) * 2.7 + 3.3) * 0.35) - h0;
		gr /= H;
		gr -= n * dot(gr, n);
		nn = normalize(nn - gr * P.warp_amount * 0.02);
	}

	if (P.condensation > 0.0)
	{
		float hgt = smoothstep(P.cond_height - 0.6, P.cond_height + 0.7, obj_pos.y);
		float up = smoothstep(0.25, 0.7, n.y);
		// 水珠一片一片地结：大块的湿区 + 凹处
		float3 pp = obj_pos * P.cond_patch_scale;
		float pn = GX_ValueNoise(pp + 7.3) * 0.7 + GX_ValueNoise(pp * 2.7 + 1.9) * 0.3;
		float patchm = smoothstep(1.0 - P.cond_patch_cover - 0.08, 1.0 - P.cond_patch_cover + 0.12, pn);
		float where_ = clamp(patchm + cav * P.cond_cavity * 1.5, 0.0, 1.0);
		float dens = P.condensation * (0.12 + 0.45 * hgt) * (1.0 - up) * where_ * clamp(noise * 1.6 - 0.1, 0.0, 1.0);
		rough = lerp(rough, rough * 0.55, dens * 0.6);
		float3 dp = obj_pos * P.droplet_scale;
		float3 slope = 0.0;
		float cover = 0.0;
		if (w.x > 0.02)
		{
			float3 d = GX_Droplets2(float2(dp.z, dp.y * 0.75), dens);
			slope += (float3(0.0, 0.0, 1.0) * d.x + float3(0.0, 1.0, 0.0) * d.y) * d.z * w.x;
			cover += d.z * w.x;
		}
		if (w.y > 0.02)
		{
			float3 d = GX_Droplets2(dp.xz, dens);
			slope += (float3(1.0, 0.0, 0.0) * d.x + float3(0.0, 0.0, 1.0) * d.y) * d.z * w.y;
			cover += d.z * w.y;
		}
		if (w.z > 0.02)
		{
			float3 d = GX_Droplets2(float2(dp.x, dp.y * 0.75), dens);
			slope += (float3(1.0, 0.0, 0.0) * d.x + float3(0.0, 1.0, 0.0) * d.y) * d.z * w.z;
			cover += d.z * w.z;
		}
		// 远处水珠小于一个像素时淡掉，免得闪
		float px = length(fwidth(dp));
		float fade = 1.0 - smoothstep(0.25, 0.6, px);
		cover *= fade;
		slope *= fade;
		nn = normalize(nn + slope);
		col *= 1.0 - cover * 0.12;
		rough = lerp(rough, 0.03, cover);
		metal = lerp(metal, 0.0, cover);
	}

	if (P.paint_depth > 0.0)
	{
		// 屏幕空间凹凸（Mikkelsen 2010）：漆层高度场的屏幕导数推出法线偏转。在物体空间里算，坐标系镜像不影响结果
		float3 dpdx = ddx(obj_pos);
		float3 dpdy = ddy(obj_pos);
		float3 r1 = cross(dpdy, nn);
		float3 r2 = cross(nn, dpdx);
		float det = dot(dpdx, r1);
		float3 grad = sign(det) * (ddx(height) * r1 + ddy(height) * r2) * P.paint_depth;
		nn = normalize(abs(det) * nn - grad);
	}

	S.BaseColor = col;
	S.Roughness = rough;
	S.Metallic = metal;
	S.Normal = nn;
	S.AO = lerp(1.0, arm.r, 0.6) * (1.0 - cav * 0.4);
	S.Emissive = P.emission_color * P.emission_energy;
	return S;
}
