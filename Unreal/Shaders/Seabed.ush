// 海床（Godot 版 assets/shaders/seabed.gdshader 的移植）：泥沙/细砂按噪声混合，陡坡露出岩石，凹处积泥更暗。
// Godot 版是世界坐标三平面映射；海床模型摆在原点不转，这里直接用局部坐标。
//
// @tex sand_albedo color white
// @tex sand_normal normal flat
// @tex sand_arm linear white
// @tex mud_albedo color white
// @tex mud_normal normal flat
// @tex rock_albedo color white
// @tex rock_normal normal flat
// @float sand_scale 0.35
// @float mud_scale 0.22
// @float rock_scale 0.12
// @color tint 0.78 0.8 0.78
// @float slope_rock_start 0.62
// @float slope_rock_end 0.42
// @float normal_strength 0.8
#pragma once

#include "/Guixu/GuixuCommon.ush"

struct FGXSeabedParams
{
	float sand_scale; float mud_scale; float rock_scale; float3 tint;
	float slope_rock_start; float slope_rock_end; float normal_strength;
};

FGXSurface GX_Seabed(FGXSeabedParams P, float3 LocalPosCm, float3 LocalNormal, float3 Wear,
	Texture2D sand_albedo, SamplerState sand_albedoSampler,
	Texture2D sand_normal, SamplerState sand_normalSampler,
	Texture2D sand_arm, SamplerState sand_armSampler,
	Texture2D mud_albedo, SamplerState mud_albedoSampler,
	Texture2D mud_normal, SamplerState mud_normalSampler,
	Texture2D rock_albedo, SamplerState rock_albedoSampler,
	Texture2D rock_normal, SamplerState rock_normalSampler)
{
	FGXSurface S = GX_DefaultSurface();
	const float3 wpos = GX_PosToGodot(LocalPosCm);
	const float3 n = normalize(GX_DirToGodot(LocalNormal));
	const float3 w = GX_TriWeights(n, 6.0);
	float4 sand = GX_Tri(sand_albedo, sand_albedoSampler, wpos * P.sand_scale, w);
	float4 sarm = GX_Tri(sand_arm, sand_armSampler, wpos * P.sand_scale, w);
	float4 mud = GX_Tri(mud_albedo, mud_albedoSampler, wpos * P.mud_scale, w);
	float4 rock = GX_Tri(rock_albedo, rock_albedoSampler, wpos * P.rock_scale, w);

	// 大块泥斑：用低频的泥贴图亮度当噪声
	float blot = GX_Tri(mud_albedo, mud_albedoSampler, wpos * 0.017, w).r;
	float mud_mask = smoothstep(0.35, 0.6, blot + Wear.g * 0.5);
	float rock_mask = 1.0 - smoothstep(P.slope_rock_end, P.slope_rock_start, n.y);
	rock_mask = clamp(rock_mask + Wear.r * 0.8, 0.0, 1.0);

	float3 col = lerp(sand.rgb, mud.rgb * 0.9, mud_mask);
	col = lerp(col, rock.rgb * 0.8, rock_mask);
	col *= P.tint * (1.0 - Wear.g * 0.35);

	float3 nn = GX_TriNormal(sand_normal, sand_normalSampler, wpos * P.sand_scale, n, w, P.normal_strength);
	float3 nm = GX_TriNormal(mud_normal, mud_normalSampler, wpos * P.mud_scale, n, w, P.normal_strength);
	float3 nr = GX_TriNormal(rock_normal, rock_normalSampler, wpos * P.rock_scale, n, w, P.normal_strength * 1.3);
	nn = normalize(lerp(lerp(nn, nm, mud_mask), nr, rock_mask));

	S.BaseColor = col;
	S.Roughness = lerp(sarm.g, 0.9, mud_mask);
	S.Metallic = 0.0;
	S.AO = sarm.r;
	S.Normal = nn;
	return S;
}
