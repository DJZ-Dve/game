# Godot 4
.godot/
/android/
/build/
/export/

# Blender 备份文件
*.blend1
*.blend2
*.blend@

# 系统文件
Thumbs.db
Desktop.ini
.DS_Store

# 截图、预览等临时文件
/.tmp/

# Python 字节码（Blender 运行脚本时生成，各平台不同）
__pycache__/

# 布料模拟缓存（blender/scripts/bedding.py，参数不变就不重算）
/blender/cache/

# 光照贴图试参数时烘到这里（tools/bake_lightmap.py 的 --lm-dir=res://lmexp/…）
/lmexp/
/override.cfg

# Unreal（UE 5.8 工程在 Unreal/）：编译产物、缓存、本机生成的工程文件
/Unreal/Binaries/
/Unreal/Intermediate/
/Unreal/Saved/
/Unreal/DerivedDataCache/
/Unreal/.vs/
/Unreal/*.sln
/Unreal/*.code-workspace
/Unreal/.vscode/
